import 'package:sl_shared/sl_shared.dart';

CREATE TABLE assets (
    uuid TEXT NOT NULL PRIMARY KEY,
    parent TEXT REFERENCES assets(uuid),
    name TEXT NOT NULL,
    type ENUM(AssetType) NOT NULL,
    properties TEXT,
    updated_at TEXT,
    blob_size INTEGER,
    blob_updated_at TEXT
);
CREATE INDEX idx_assets_parent ON assets(parent);

getAssetByUUID(:uuid as TEXT): SELECT * FROM assets WHERE uuid = :uuid;

getAssetsInDirectory(:directory_uuid as TEXT OR NULL): WITH RECURSIVE
    asset_tree AS (
        SELECT
            a.uuid,
            a.parent,
            a.name,
            a.type,
            a.properties,
            a.updated_at,
            a.blob_size,
            a.blob_updated_at,
            0 AS depth
        FROM assets a
        WHERE a.parent = :directory_uuid OR (a.parent IS NULL AND :directory_uuid IS NULL)

        UNION ALL

        SELECT
            sa.uuid,
            sa.parent,
            sa.name,
            sa.type,
            sa.properties,
            sa.updated_at,
            sa.blob_size,
            sa.blob_updated_at,
            at.depth + 1
        FROM assets sa
        JOIN asset_tree at
            ON sa.parent = at.uuid
        WHERE at.type <> 0 -- type != directory
    )
    SELECT
        uuid,
        parent,
        name,
        type,
        properties,
        updated_at,
        blob_size,
        blob_updated_at,
        depth
    FROM asset_tree
    ORDER BY depth, parent, name;